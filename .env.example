# Copy to .env and fill in. .env is gitignored - never commit it.

# --- Neo4j Aura Free ---
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# --- Inference: GitHub Copilot CLI ---
# No token here. The Copilot CLI holds its own credentials after you run
# `copilot` once and sign in. Nothing secret belongs in this section.
COPILOT_CMD=copilot
COPILOT_TIMEOUT_S=45

# --- Behaviour ---
SIGNIFICANCE_THRESHOLD=1.8
MODEL_ENABLED=true
